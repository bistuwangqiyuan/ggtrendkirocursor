# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database

# Session Configuration
# Signs the session cookie so the middleware can validate a session without
# querying Postgres on every request (the single biggest source of Neon compute
# wake-ups). Must be at least 16 characters or signing is disabled and every
# request falls back to a database lookup.
SESSION_SECRET=your-secret-key-here-change-in-production
# Minutes a signed cookie is trusted before the `sessions` table is re-checked.
# Trade-off: a cookie captured before logout stays usable for at most this long.
# Set to 0 to disable stateless trust entirely (validates on every request).
SESSION_REVALIDATE_MINUTES=30

# Environment
NODE_ENV=development

# LLM Configuration (Hot word -> Business Plan feature)
# Option A — single endpoint (legacy):
LLM_API_KEY=
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# Option B — multiple endpoints with auto-failover (takes precedence when set):
# On failure (timeout / HTTP 4xx/5xx / auth), the next endpoint is tried automatically.
# The last successful endpoint is preferred for subsequent requests.
# LLM_API_ENDPOINTS=[{"name":"dashscope","base":"https://dashscope.aliyuncs.com/compatible-mode/v1","key":"sk-xxx","model":"qwen-plus"},{"name":"openai","base":"https://api.openai.com/v1","key":"sk-yyy","model":"gpt-4o-mini"}]

LLM_TIMEOUT_MS=45000

# Scheduled BP auto-generation (every 6h via Netlify Scheduled Function)
# Required to enable POST /api/bp/cron. Use a long random value.
# The Netlify function sends `Authorization: Bearer ${CRON_SECRET}`.
CRON_SECRET=

# Admin secret for the destructive ops endpoints (/api/db-init, /api/seed).
# Use a long random value; falls back to CRON_SECRET when unset. With neither
# configured those endpoints are disabled (fail closed, 503).
ADMIN_SECRET=

# --- Snapshot layer (keeps page reads off Postgres) -------------------------
# Read paths serve JSON snapshots from Netlify Blobs instead of querying Neon.
# Force the filesystem backend (useful for local dev / tests): SNAPSHOT_BACKEND=fs
# SNAPSHOT_BACKEND=
# Directory for the filesystem backend (default .snapshots).
# SNAPSHOT_DIR=.snapshots
# Allow read paths to fall back to Postgres when a snapshot is missing. OFF by
# default: silent DB fallback would restore the traffic pattern that exhausts the
# Neon compute quota, and would hide a broken snapshot pipeline.
# ALLOW_DB_READ_FALLBACK=false
# Snapshot size / per-run write caps (defaults shown).
# TRENDS_SNAPSHOT_MAX=5000
# BP_LIST_SNAPSHOT_MAX=2000
# LANDING_DETAIL_WRITES_PER_RUN=800
# BP_DETAIL_WRITES_PER_RUN=40

# --- Observability ---------------------------------------------------------
# Days of error logs / DB wake-up metrics to keep in Blobs (default 30).
# ERROR_LOG_RETENTION_DAYS=30

# --- Data retention (storage stays under the 0.5 GB free-tier limit) --------
# TRENDS_RETENTION_DAYS=30
# SITE_CHECKS_RETENTION_DAYS=90
