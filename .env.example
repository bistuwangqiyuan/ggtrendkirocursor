# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database

# Session Configuration
# Signs the session cookie so the middleware can validate a session without
# querying Postgres on every request (the single biggest source of Neon compute
# wake-ups). Must be at least 16 characters or signing is disabled and every
# request falls back to a database lookup.
SESSION_SECRET=your-secret-key-here-change-in-production
# Minutes a signed cookie is trusted before the `sessions` table is re-checked.
# Trade-off: a cookie captured before logout stays usable for at most this long.
# Set to 0 to disable stateless trust entirely (validates on every request).
SESSION_REVALIDATE_MINUTES=30

# Environment
NODE_ENV=development

# LLM Configuration (Hot word -> Business Plan feature)
# Option A — single endpoint (legacy):
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# Option B — multiple endpoints with auto-failover (takes precedence when set):
# On failure (timeout / HTTP 4xx/5xx / auth), the next endpoint is tried automatically.
# The last successful endpoint is preferred for subsequent requests.
# DeepSeek V4 is first; other providers remain as failover.
# LLM_API_ENDPOINTS=[{"name":"deepseek","base":"https://api.deepseek.com","key":"sk-xxx","model":"deepseek-v4-pro"},{"name":"dashscope","base":"https://dashscope.aliyuncs.com/compatible-mode/v1","key":"sk-yyy","model":"qwen-plus"}]

LLM_TIMEOUT_MS=45000

# Scheduled BP auto-generation (every 6h via Netlify Scheduled Function)
# Required to enable POST /api/bp/cron. Use a long random value.
# The Netlify function sends `Authorization: Bearer ${CRON_SECRET}`.
CRON_SECRET=

# Admin secret for the destructive ops endpoints (/api/db-init, /api/seed).
# Use a long random value; falls back to CRON_SECRET when unset. With neither
# configured those endpoints are disabled (fail closed, 503).
ADMIN_SECRET=

# --- Snapshot layer (keeps page reads off Postgres) -------------------------
# Read paths serve JSON snapshots from Netlify Blobs instead of querying Neon.
# Force the filesystem backend (useful for local dev / tests): SNAPSHOT_BACKEND=fs
# SNAPSHOT_BACKEND=
# Directory for the filesystem backend (default .snapshots).
# SNAPSHOT_DIR=.snapshots
# Allow read paths to fall back to Postgres when a snapshot is missing. OFF by
# default: silent DB fallback would restore the traffic pattern that exhausts the
# Neon compute quota, and would hide a broken snapshot pipeline.
# ALLOW_DB_READ_FALLBACK=false
# Snapshot size / per-run write caps (defaults shown).
# TRENDS_SNAPSHOT_MAX=5000
# BP_LIST_SNAPSHOT_MAX=2000
# LANDING_DETAIL_WRITES_PER_RUN=800
# BP_DETAIL_WRITES_PER_RUN=40

# --- Outage resilience (Neon on the free plan is periodically unavailable) ---
# Harvested hotwords are queued in Blobs when Postgres refuses the write, and
# replayed when it returns. A queued harvest is kept as long as the BP picker
# would still consider it (48h), then dropped as unanalyzable.
# TRENDS_INTAKE_TTL_HOURS=48
# During an outage the batch plans from a cached copy of the dedupe sets. Past
# this age the copy has missed too many writes to steer selection, and the run
# reports no candidates instead of guessing.
# BP_DEDUPE_CACHE_MAX_AGE_HOURS=72
# The hourly recovery job drains that backlog as soon as the database is back,
# and rebuilds snapshots that stopped being refreshed. It touches Postgres only
# when there IS something wrong. Set false to disable.
# PIPELINE_RECOVERY_ENABLED=true
# PIPELINE_RECOVERY_MIN_INTERVAL_MINUTES=55
# How old the newest snapshot may get before the read side counts as frozen: the
# write window is every 3h, so this is two missed windows plus an hour of slack.
# Past it, /api/snapshots/status answers 503 and the watchdog rebuilds through the
# SSR route. Lower it only if you have a monitor that tolerates the false alarms.
# SNAPSHOT_MAX_AGE_SECONDS=25200

# --- Observability ---------------------------------------------------------
# Days of error logs / DB wake-up metrics to keep in Blobs (default 30).
# ERROR_LOG_RETENTION_DAYS=30

# --- Data retention (storage stays under the 0.5 GB free-tier limit) --------
# TRENDS_RETENTION_DAYS=30
# SITE_CHECKS_RETENTION_DAYS=90

# --- Two Netlify accounts, one writer ---------------------------------------
# The site is deployed twice, on two accounts, so one account's exhausted build
# credits cannot take the product offline. Both deployments serve pages and take
# payments; exactly ONE runs the cron pipeline, or Neon would be woken twice and
# the same hotwords would be paid for twice in LLM tokens.
#   writer (default when unset) — runs bp-scheduled and pipeline-recovery
#   reader                      — no cron at all, snapshots arrive from the
#                                 publish-snapshots workflow
# SITE_ROLE=writer

# --- Payments: $1 report PDF ------------------------------------------------
# A provider is only offered when BOTH its API key and its webhook secret are
# set: selling through a provider whose webhook cannot be verified would take
# the money with no way to prove the payment happened. With neither provider
# configured the buy UI disappears and the site is exactly as it was before.
#
# Creem (primary; supports Alipay / cards, merchant of record):
CREEM_API_KEY=
CREEM_PRODUCT_ID=
CREEM_WEBHOOK_SECRET=
# Point at the sandbox while testing (test-mode keys only work against it):
# CREEM_TEST_MODE=false
#
# Lemon Squeezy (automatic fallback when Creem's API call fails):
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Try providers in this order (comma separated). Anything omitted is appended,
# so a typo cannot silently disable a configured provider.
# PAYMENT_PROVIDER_ORDER=creem,lemonsqueezy
#
# The advertised price, in cents. Display only — the amount actually charged is
# whatever the provider's product says, which is why the browser never sends it.
# Keep the two in sync by hand; a mismatch is a refund request waiting to happen.
# PAYMENT_PRICE_CENTS=100
#
# Signs download links, guest order-lookup links and claim links. Falls back to
# SESSION_SECRET when unset; set it separately so rotating one does not
# invalidate the other. Minimum 16 characters or paid downloads are disabled.
PAYMENT_TOKEN_SECRET=

# --- Transactional email (Resend) -------------------------------------------
# Only used to send guest order-lookup and claim magic links. Without it, guests
# can still download right after paying (the success page carries the purchase
# reference); they just cannot ask for the link again later.
RESEND_API_KEY=
# Must be a domain verified in Resend, or the provider rejects the send.
# EMAIL_FROM=ioni.top <no-reply@ioni.top>
