# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database

# Session Configuration
SESSION_SECRET=your-secret-key-here-change-in-production

# Environment
NODE_ENV=development

# LLM Configuration (Hot word -> Business Plan feature)
# Option A — single endpoint (legacy):
LLM_API_KEY=
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# Option B — multiple endpoints with auto-failover (takes precedence when set):
# On failure (timeout / HTTP 4xx/5xx / auth), the next endpoint is tried automatically.
# The last successful endpoint is preferred for subsequent requests.
# LLM_API_ENDPOINTS=[{"name":"dashscope","base":"https://dashscope.aliyuncs.com/compatible-mode/v1","key":"sk-xxx","model":"qwen-plus"},{"name":"openai","base":"https://api.openai.com/v1","key":"sk-yyy","model":"gpt-4o-mini"}]

LLM_TIMEOUT_MS=45000

# Scheduled BP auto-generation (every 6h via Netlify Scheduled Function)
# Required to enable POST /api/bp/cron. Use a long random value.
# The Netlify function sends `Authorization: Bearer ${CRON_SECRET}`.
CRON_SECRET=
