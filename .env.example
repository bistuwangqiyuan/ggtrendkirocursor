# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database

# Session Configuration
SESSION_SECRET=your-secret-key-here-change-in-production

# Environment
NODE_ENV=development

# LLM Configuration (Hot word -> Business Plan feature)
# OpenAI-compatible Chat Completions endpoint. Without LLM_API_KEY the BP
# generation endpoint returns a clear "not configured" error (no fallback).
LLM_API_KEY=
# Defaults to Aliyun DashScope OpenAI-compatible endpoint if unset.
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TIMEOUT_MS=45000
