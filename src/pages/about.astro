---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../lib/i18n';

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);
---

<Layout title={t.nav.about}>
  <div class="max-w-3xl mx-auto prose prose-invert">
    <h1 class="text-3xl font-bold mb-6 text-white">{t.nav.about} Trend Now</h1>
    
    <div class="space-y-4 text-gray-300">
      <p>
        {locale === 'zh' 
          ? 'Trend Now 是一个致力于提供实时 Google Trends 数据分析的平台。我们的目标是帮助营销人员、内容创作者和数据分析师快速了解当前的市场趋势。'
          : 'Trend Now is a platform dedicated to providing real-time Google Trends data analysis. Our goal is to help marketers, content creators, and data analysts quickly understand current market trends.'}
      </p>
      
      <h2 class="text-xl font-semibold text-white mt-8 mb-4">
        {locale === 'zh' ? '我们的使命' : 'Our Mission'}
      </h2>
      <p>
        {locale === 'zh'
          ? '通过直观的数据可视化和实时更新，让数据驱动决策变得简单高效。'
          : 'Making data-driven decisions simple and efficient through intuitive data visualization and real-time updates.'}
      </p>
    </div>
  </div>
</Layout>

