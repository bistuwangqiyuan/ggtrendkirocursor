---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../lib/i18n';
import { applyPageCache, CACHE_PROFILES } from '../lib/cache/httpCache';

// Pure content with no data dependency: let the edge serve it to anonymous
// visitors and crawlers so these routes never invoke a function per request.
applyPageCache(Astro, CACHE_PROFILES.staticPage);

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);
const a = t.about;
---

<Layout title={a.title} description={a.metaDescription}>
  <div class="max-w-3xl mx-auto" data-page="about">
    <h1 class="text-3xl font-bold text-white mb-6">{a.title}</h1>
    <p class="text-gray-300 leading-relaxed mb-10">{a.intro}</p>

    {[a.mission, a.vision, a.methodology, a.transparency].map(section => (
      <section class="legal-section">
        <h3>{section.title}</h3>
        <p>{section.body}</p>
      </section>
    ))}
  </div>
</Layout>
