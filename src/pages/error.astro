---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../lib/i18n';

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);
const { error } = Astro.props;
---

<Layout title={t.errors.errorTitle}>
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
    <h1 class="text-6xl font-bold text-red-600 mb-4">{t.errors.errorHeading}</h1>
    <p class="text-gray-400 mb-8">{t.auth.errors.generic}</p>
    {import.meta.env.DEV && error && (
      <pre class="bg-gray-900 p-4 rounded text-left text-xs text-red-300 overflow-auto max-w-2xl mb-8">
        {error.stack || error.message}
      </pre>
    )}
    <a href="/" class="btn !rounded-lg">{t.common.backToHome}</a>
  </div>
</Layout>
