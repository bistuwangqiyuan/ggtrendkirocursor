---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../lib/i18n';

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);

// Capture error from props if passed (though usually handled by middleware or framework)
const { error } = Astro.props;
---

<Layout title={t.common.error}>
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
    <h1 class="text-6xl font-bold text-red-600 mb-4">Error</h1>
    <h2 class="text-2xl font-bold text-white mb-6">{t.common.error}</h2>
    <p class="text-gray-400 mb-8">
      {t.auth.errors.generic}
    </p>
    {import.meta.env.DEV && error && (
      <pre class="bg-gray-900 p-4 rounded text-left text-xs text-red-300 overflow-auto max-w-2xl mb-8">
        {error.stack || error.message}
      </pre>
    )}
    <a href="/" class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-6 rounded-md transition-colors">
      {t.nav.home}
    </a>
  </div>
</Layout>

