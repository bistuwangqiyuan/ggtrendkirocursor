---
import Layout from '../layouts/Layout.astro';
import { FeedbackForm } from '../components/feedback/FeedbackForm';
import { getTranslations } from '../lib/i18n';

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);
const user = Astro.locals.user;
---

<Layout title={t.feedback.title}>
  <div class="max-w-xl mx-auto" data-page="contact">
    <h1 class="text-3xl font-bold text-white mb-2">{t.feedback.title}</h1>
    <p class="text-gray-400 mb-8">
      {t.feedback.emailLabel}:
      <a href="mailto:13426086861@139.com" class="text-blue-400 hover:text-blue-300 no-underline ml-1">13426086861@139.com</a>
    </p>
    <FeedbackForm
      client:load
      locale={locale}
      translations={{ feedback: t.feedback }}
      user={user ? { name: user.username, email: user.email } : undefined}
    />
  </div>
</Layout>
