---
import Layout from '../layouts/Layout.astro';
import { LoginForm } from '../components/auth/LoginForm';
import { getTranslations } from '../lib/i18n';

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);

// Validate the redirect target is an internal path (prevent open-redirect).
const redirectParam = Astro.url.searchParams.get('redirect');
const safeRedirect = redirectParam && /^\/(?!\/)[A-Za-z0-9/_\-?=&.%]*$/.test(redirectParam)
  ? redirectParam
  : '/';

// Redirect if already logged in
if (Astro.locals.user) {
  return Astro.redirect(safeRedirect);
}
---

<Layout title={t.auth.login}>
  <div class="max-w-md mx-auto mt-20 p-6 bg-gray-900/50 border border-gray-800 rounded-xl shadow-2xl">
    <h1 class="text-2xl font-bold text-center mb-8 text-white">{t.auth.login}</h1>
    <LoginForm client:load locale={locale} translations={{ auth: t.auth }} redirectTo={safeRedirect} />
    <div class="mt-6 text-center text-sm text-gray-400">
      {t.nav.noAccount} <a href="/register" class="text-blue-400 hover:underline no-underline">{t.auth.register}</a>
    </div>
  </div>
</Layout>

