---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../lib/i18n';

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);
---

<Layout title={t.errors.notFoundTitle}>
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
    <h1 class="text-6xl font-bold text-blue-600 mb-4">404</h1>
    <h2 class="text-2xl font-bold text-white mb-6">{t.errors.notFoundHeading}</h2>
    <p class="text-gray-400 mb-8">{t.errors.notFoundBody}</p>
    <a href="/" class="btn !rounded-lg">{t.common.backToHome}</a>
  </div>
</Layout>
