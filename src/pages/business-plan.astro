---
// Login-gated flagship pitch deck. Served as its own print-paged document
// (single source of truth = the same HTML the PDF is rendered from).
import deckHtml from '../../bp/business-plan.html?raw';
import { getTranslations } from '../lib/i18n';

export const prerender = false;

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);

// Gate: guests are sent to login and bounced back here afterwards.
if (!Astro.locals.user) {
  return Astro.redirect('/login?redirect=/business-plan');
}

// The standalone deck uses relative `assets/...` paths (for Puppeteer / double-click).
// When served at /business-plan, rewrite them to the mirrored public location.
let html = deckHtml.replace(/(["'(])assets\//g, '$1/business-plan/assets/');

const backLabel = locale === 'en' ? 'Back' : '返回';
const exportLabel = locale === 'en' ? 'Export PDF' : '导出 PDF';
const docTitle = locale === 'en'
  ? 'Business Plan · Google Hotword → AI Analysis → Auto-built Website'
  : '谷歌热词全自动 AI BP 生成网站 · 商业计划书';

const toolbar = `
<div class="bp-toolbar" role="toolbar" aria-label="${docTitle}">
  <a class="bp-tb-btn" href="/">&#8592; ${backLabel}</a>
  <span class="bp-tb-title">${docTitle}</span>
  <button class="bp-tb-btn bp-tb-primary" type="button" onclick="window.print()">${exportLabel}</button>
</div>
${locale === 'en' ? `<div class="bp-en-notice" role="note">${t.flagship.enNotice}</div>` : ''}
<style>
  .bp-en-notice{background:#fff8ef;border-bottom:1px solid #ffe2b8;padding:10px 18px;font-size:13px;color:#9a5b00;
    font-family:"Inter","Noto Sans SC",-apple-system,sans-serif;text-align:center;}
  .bp-toolbar{position:sticky;top:0;z-index:1000;display:flex;align-items:center;gap:12px;
    height:54px;padding:0 18px;background:rgba(245,245,247,.82);backdrop-filter:saturate(180%) blur(18px);
    -webkit-backdrop-filter:saturate(180%) blur(18px);border-bottom:1px solid #d2d2d7;
    font-family:"Inter","Noto Sans SC",-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;}
  .bp-tb-title{flex:1;text-align:center;font-size:13px;font-weight:600;color:#1d1d1f;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .bp-tb-btn{appearance:none;border:1px solid #d2d2d7;background:#fff;color:#1d1d1f;
    font-size:13px;font-weight:600;line-height:1;padding:9px 16px;border-radius:980px;cursor:pointer;
    text-decoration:none;transition:background .15s ease,border-color .15s ease;white-space:nowrap;}
  .bp-tb-btn:hover{background:#f0f0f3;}
  .bp-tb-primary{background:#0071e3;border-color:#0071e3;color:#fff;}
  .bp-tb-primary:hover{background:#0077ed;}
  @media (max-width:640px){ .bp-tb-title{display:none;} }
  @media print{ .bp-toolbar{display:none !important;} }
</style>`;

html = html.replace('<body>', '<body>\n' + toolbar);

return new Response(html, {
  status: 200,
  headers: { 'Content-Type': 'text/html; charset=utf-8' },
});
---
