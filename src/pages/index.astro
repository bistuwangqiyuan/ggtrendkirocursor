---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../lib/i18n';

export const prerender = false;

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);
const h = t.home;
---

<Layout title={h.title} description={t.common.metaDescription}>
  <div data-page="marketing-home">
    <!-- Hero -->
    <section class="relative mkt-section mkt-hero-glow -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center motion-fade-in">
        <p class="mkt-eyebrow">{h.hero.eyebrow}</p>
        <h1 class="mkt-headline" data-testid="hero-headline">{h.hero.headline}</h1>
        <p class="mkt-subhead mx-auto">{h.hero.subhead}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
          <a href="/trends" class="btn btn-lg !rounded-xl">{h.hero.ctaPrimary}</a>
          <a href="/product" class="btn-outline btn-lg !rounded-xl">{h.hero.ctaSecondary}</a>
        </div>
      </div>
      <div class="max-w-5xl mx-auto mt-14 rounded-2xl overflow-hidden border border-gray-800 shadow-2xl">
        <img src="/images/marketing/hero.png" alt="" class="w-full h-auto" loading="eager" />
      </div>
    </section>

    <div class="mkt-divider"></div>

    <!-- Closed loop -->
    <section class="mkt-section-sm">
      <div class="text-center mb-12">
        <p class="mkt-eyebrow">{h.loop.title}</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-white">{h.loop.subtitle}</h2>
      </div>
      <div class="mkt-grid-3">
        <div class="mkt-card">
          <span class="mkt-pill mb-4">01</span>
          <h3 class="text-lg font-semibold text-white mb-2">{h.loop.step1Title}</h3>
          <p class="text-gray-400 text-sm leading-relaxed">{h.loop.step1Desc}</p>
        </div>
        <div class="mkt-card">
          <span class="mkt-pill mb-4">02</span>
          <h3 class="text-lg font-semibold text-white mb-2">{h.loop.step2Title}</h3>
          <p class="text-gray-400 text-sm leading-relaxed">{h.loop.step2Desc}</p>
        </div>
        <div class="mkt-card">
          <span class="mkt-pill mb-4">03</span>
          <h3 class="text-lg font-semibold text-white mb-2">{h.loop.step3Title}</h3>
          <p class="text-gray-400 text-sm leading-relaxed">{h.loop.step3Desc}</p>
        </div>
      </div>
      <div class="max-w-3xl mx-auto mt-10 rounded-2xl overflow-hidden border border-gray-800">
        <img src="/images/marketing/closed-loop.png" alt="" class="w-full h-auto" loading="lazy" />
      </div>
    </section>

    <!-- Capabilities -->
    <section class="mkt-section-sm">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-white">{h.capabilities.title}</h2>
        <p class="mkt-subhead mx-auto">{h.capabilities.subtitle}</p>
      </div>
      <div class="mkt-grid-3">
        {[['c1', h.capabilities.c1Title, h.capabilities.c1Desc], ['c2', h.capabilities.c2Title, h.capabilities.c2Desc], ['c3', h.capabilities.c3Title, h.capabilities.c3Desc], ['c4', h.capabilities.c4Title, h.capabilities.c4Desc], ['c5', h.capabilities.c5Title, h.capabilities.c5Desc], ['c6', h.capabilities.c6Title, h.capabilities.c6Desc]].map(([, title, desc]) => (
          <div class="mkt-card">
            <h3 class="text-base font-semibold text-white mb-2">{title}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Sample report -->
    <section class="mkt-section-sm">
      <div class="mkt-grid-2 items-center gap-10">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">{h.sample.title}</h2>
          <p class="text-gray-400 mb-6 leading-relaxed">{h.sample.subtitle}</p>
          <a href="/bp" class="btn !rounded-xl">{h.sample.cta}</a>
        </div>
        <div class="rounded-2xl overflow-hidden border border-gray-800 shadow-xl">
          <img src="/images/marketing/sample-report.png" alt="" class="w-full h-auto" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- Trust -->
    <section class="mkt-section-sm">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-white">{h.trust.title}</h2>
        <p class="mkt-subhead mx-auto">{h.trust.subtitle}</p>
      </div>
      <div class="mkt-grid-3 mb-8">
        <div class="mkt-stat">
          <div class="text-lg font-semibold text-white mb-2">{h.trust.t1Title}</div>
          <p class="text-sm text-gray-400">{h.trust.t1Desc}</p>
        </div>
        <div class="mkt-stat">
          <div class="text-lg font-semibold text-white mb-2">{h.trust.t2Title}</div>
          <p class="text-sm text-gray-400">{h.trust.t2Desc}</p>
        </div>
        <div class="mkt-stat">
          <div class="text-lg font-semibold text-white mb-2">{h.trust.t3Title}</div>
          <p class="text-sm text-gray-400">{h.trust.t3Desc}</p>
        </div>
      </div>
      <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 px-5 py-4 text-sm text-amber-200/90 text-center max-w-3xl mx-auto">
        {h.trust.disclaimer}
      </div>
    </section>

    <!-- Pricing + FAQ teasers -->
    <section class="mkt-section-sm">
      <div class="mkt-grid-2 gap-8">
        <div class="mkt-card">
          <h3 class="text-xl font-bold text-white mb-2">{h.pricingTeaser.title}</h3>
          <p class="text-gray-400 text-sm mb-1">{h.pricingTeaser.subtitle}</p>
          <p class="text-blue-400 font-semibold mb-4">{h.pricingTeaser.from}</p>
          <a href="/pricing" class="mkt-link">{h.pricingTeaser.cta} →</a>
        </div>
        <div class="mkt-card">
          <h3 class="text-xl font-bold text-white mb-4">{h.faqTeaser.title}</h3>
          <div class="space-y-4 text-sm">
            <div>
              <p class="font-medium text-white">{h.faqTeaser.q1}</p>
              <p class="text-gray-400 mt-1">{h.faqTeaser.a1}</p>
            </div>
            <div>
              <p class="font-medium text-white">{h.faqTeaser.q2}</p>
              <p class="text-gray-400 mt-1">{h.faqTeaser.a2}</p>
            </div>
          </div>
          <a href="/faq" class="mkt-link mt-4 inline-block">{h.faqTeaser.cta} →</a>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="mkt-section-sm pb-8">
      <div class="rounded-2xl border border-blue-500/30 bg-gradient-to-br from-blue-950/50 to-gray-900/80 p-10 sm:p-14 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">{h.finalCta.title}</h2>
        <p class="text-gray-400 mb-8 max-w-lg mx-auto">{h.finalCta.subtitle}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/register" class="btn btn-lg !rounded-xl">{h.finalCta.cta}</a>
          <a href="/trends" class="btn-outline btn-lg !rounded-xl">{h.finalCta.ctaTrends}</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
