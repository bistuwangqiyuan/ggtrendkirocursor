---
import Layout from '../layouts/Layout.astro';
import TrendsTable from '../components/trends/TrendsTable.astro';
import { TrendsFilters } from '../components/trends/TrendsFilters';
import { Pagination } from '../components/trends/Pagination';
import { trendsService } from '../lib/services/trends';
import { getTranslations } from '../lib/i18n';
import type { TrendsQueryParams } from '../types/index';

// Enable SSR back
export const prerender = false;

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);

// Parse Query Params
const urlTimeRange = Astro.url.searchParams.get('timeRange') || '';
const collectedWithin = Astro.url.searchParams.get('collectedWithin') || '';
const keyword = Astro.url.searchParams.get('keyword') || '';
const category = Astro.url.searchParams.get('category') || '';
const page = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const pageSize = 20;

const params: TrendsQueryParams = {
    timeRange: urlTimeRange || undefined,
    collectedWithin: collectedWithin || undefined,
    keyword: keyword || undefined,
    category: category || undefined,
    page,
    pageSize,
    sortBy: 'search_volume',
    sortOrder: 'desc'
};

// Fetch Data
const categoriesResult = await trendsService.getCategories();
let trendsResult = await trendsService.getTrends(params);

// Fallback: if no data for the selected time range, try without time_range filter
if (trendsResult.success && trendsResult.data.trends.length === 0 && urlTimeRange) {
    trendsResult = await trendsService.getTrends({
        ...params,
        timeRange: undefined
    });
}

const timeRange = urlTimeRange || '4h';
const trendsData = trendsResult.success ? trendsResult.data : { trends: [], pagination: { currentPage: 1, totalPages: 1, totalItems: 0, pageSize: 20 } };
const categories = categoriesResult.success ? categoriesResult.data : [];
const error = !trendsResult.success ? trendsResult.error : null;
---

<Layout title={t.trends.title}>
    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <h1 class="text-3xl font-bold tracking-tight text-white">
                {t.trends.title}
            </h1>
            <div class="text-sm text-gray-400">
                {t.trends.timeRange[timeRange as keyof typeof t.trends.timeRange]}
            </div>
        </div>

        {error && <div class="bg-red-500/10 border border-red-500/20 text-red-400 px-4 py-3 rounded-md">{t.auth.errors.generic}</div>}

        <TrendsFilters
            client:load
            initialFilters={{ timeRange, collectedWithin, keyword, category }}
            categories={categories}
            locale={locale}
            translations={{ trends: t.trends }}
        />

        <TrendsTable trends={trendsData.trends} locale={locale} />

        <Pagination
            client:load
            currentPage={trendsData.pagination.currentPage}
            totalPages={trendsData.pagination.totalPages}
            totalItems={trendsData.pagination.totalItems}
            pageSize={trendsData.pagination.pageSize}
            locale={locale}
            translations={{ trends: t.trends }}
        />
    </div>
</Layout>
