---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../lib/i18n';

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);
const lp = t.legal.privacy;
---

<Layout title={lp.title} description={lp.metaDescription}>
  <div class="max-w-3xl mx-auto prose prose-invert" data-page="privacy">
    <h1 class="text-3xl font-bold text-white mb-2">{lp.title}</h1>
    <p class="text-sm text-gray-500 mb-8">{t.common.lastUpdated}: {t.legal.lastUpdatedDate}</p>

    {lp.sections.map(section => (
      <section class="legal-section">
        <h3>{section.heading}</h3>
        <p>{section.body}</p>
      </section>
    ))}
  </div>
</Layout>
