---
/**
 * "My downloads" for accounts, and the same list for a guest who opened a magic
 * link.
 *
 * Two ways in, one page: a session, or a signed `orders` token naming an email.
 * A visitor with neither gets the lookup form instead of an empty list, because
 * an empty list would read as "your purchase is gone".
 *
 * Never cached (see NO_STORE_HEADERS): the body is per-buyer and the download
 * links inside it are capabilities.
 */
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../lib/i18n';
import { NO_STORE_HEADERS } from '../lib/cache/httpCache';
import { listPurchases, OrdersUnavailableError, type Purchase } from '../lib/services/orders';
import { issueDownloadToken, verifyToken } from '../lib/payments/tokens';
import { formatDateTime } from '../lib/utils/format';

for (const [key, value] of Object.entries(NO_STORE_HEADERS)) {
  Astro.response.headers.set(key, value);
}

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);
const o = t.orders;
const user = Astro.locals.user;

// A guest arrives with a magic-link token; expiry is a normal outcome here, not
// an error, so it gets its own message and the form stays on the page.
const rawToken = Astro.url.searchParams.get('token');
const tokenResult = rawToken ? verifyToken(rawToken, 'orders') : null;
const tokenEmail = tokenResult?.ok ? tokenResult.claims.email || null : null;
const tokenExpired = !!rawToken && !tokenResult?.ok;

const claimResult = Astro.url.searchParams.get('claim');
const claimCount = Number(Astro.url.searchParams.get('n') || 0);

let purchases: Purchase[] = [];
let degraded = false;

if (user || tokenEmail) {
  try {
    purchases = await listPurchases({ userId: user?.id, email: tokenEmail || user?.email });
  } catch (error) {
    // A database outage must not read as "you never bought anything".
    degraded = error instanceof OrdersUnavailableError;
    if (!degraded) throw error;
  }
}

const rows = purchases.map((p) => ({
  id: p.id,
  reportId: p.reportId,
  title: p.reportTitle || p.reportKeyword || p.reportId || '—',
  date: formatDateTime(p.paidAt || p.createdAt, locale),
  amount: p.amountCents === null ? '—' : `$${(p.amountCents / 100).toFixed(2)}`,
  status: p.status,
  // Issued per render rather than stored: the link is only as long-lived as the
  // token, and a refunded order is re-checked at download time anyway.
  downloadUrl:
    p.status === 'paid' && p.reportId
      ? (() => {
          const token = issueDownloadToken(p.id, p.reportId);
          return token ? `/api/download/bp/${p.reportId}?token=${encodeURIComponent(token)}` : null;
        })()
      : null,
}));

const claimMessage =
  claimResult === 'ok'
    ? o.claimOk.replace('{n}', String(claimCount))
    : claimResult === 'wrong_account'
      ? o.claimWrongAccount
      : claimResult === 'expired'
        ? o.claimExpired
        : claimResult
          ? o.claimFailed
          : null;
---

<Layout title={o.title} description={o.metaDescription}>
  <div class="mx-auto max-w-4xl" data-page="orders">
    <h1 class="text-3xl font-bold text-white">{o.title}</h1>
    <p class="mt-2 text-sm text-gray-400">{o.subtitle}</p>

    {claimMessage && (
      <p
        class={`mt-4 rounded-lg border px-4 py-3 text-sm ${
          claimResult === 'ok'
            ? 'border-emerald-500/30 bg-emerald-950/40 text-emerald-300'
            : 'border-amber-500/30 bg-amber-950/30 text-amber-300'
        }`}
      >
        {claimMessage}
      </p>
    )}

    {tokenExpired && (
      <p class="mt-4 rounded-lg border border-amber-500/30 bg-amber-950/30 px-4 py-3 text-sm text-amber-300">
        {o.linkExpired}
      </p>
    )}

    {degraded && (
      <p class="mt-4 rounded-lg border border-amber-500/30 bg-amber-950/30 px-4 py-3 text-sm text-amber-300">
        {o.degraded}
      </p>
    )}

    {(user || tokenEmail) && !degraded && (
      <section class="mt-8">
        {rows.length === 0 ? (
          <p class="rounded-xl border border-white/10 bg-white/5 px-5 py-8 text-center text-sm text-gray-400">
            {o.empty}
          </p>
        ) : (
          <div class="overflow-x-auto rounded-xl border border-white/10">
            <table class="w-full text-sm">
              <thead class="bg-white/5 text-left text-xs uppercase tracking-wide text-gray-400">
                <tr>
                  <th class="px-4 py-3">{o.columns.report}</th>
                  <th class="px-4 py-3">{o.columns.date}</th>
                  <th class="px-4 py-3">{o.columns.amount}</th>
                  <th class="px-4 py-3">{o.columns.status}</th>
                  <th class="px-4 py-3"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                {rows.map((row) => (
                  <tr>
                    <td class="px-4 py-3 text-gray-200">
                      {row.reportId ? (
                        <a href={`/bp/${row.reportId}`} class="hover:text-blue-300">{row.title}</a>
                      ) : (
                        row.title
                      )}
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-gray-400">{row.date}</td>
                    <td class="whitespace-nowrap px-4 py-3 text-gray-400">{row.amount}</td>
                    <td class="whitespace-nowrap px-4 py-3">
                      <span class={row.status === 'paid' ? 'text-emerald-400' : 'text-gray-500'}>
                        {o.status[row.status as 'paid' | 'refunded' | 'pending']}
                      </span>
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-right">
                      {row.downloadUrl && (
                        <a
                          href={row.downloadUrl}
                          class="rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-blue-500"
                        >
                          {o.download}
                        </a>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    )}

    <section class="mt-10 rounded-xl border border-white/10 bg-white/5 p-6">
      <h2 class="text-lg font-semibold text-white">{o.guestTitle}</h2>
      <p class="mt-2 text-sm text-gray-400">{o.guestDesc}</p>
      <form id="orders-lookup" class="mt-4 flex flex-wrap gap-3">
        <input
          type="email"
          name="email"
          required
          placeholder={t.pay.emailPlaceholder}
          class="min-w-[260px] flex-1 rounded-lg border border-white/10 bg-black/30 px-3 py-2 text-sm text-white placeholder-gray-600 focus:border-blue-500 focus:outline-none"
        />
        <button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-500">
          {o.guestCta}
        </button>
      </form>
      <p id="orders-lookup-status" class="mt-3 text-xs text-gray-400" role="status" aria-live="polite"></p>
    </section>

    {user && (
      <section class="mt-6 rounded-xl border border-white/10 bg-white/5 p-6">
        <h2 class="text-lg font-semibold text-white">{o.claimTitle}</h2>
        <p class="mt-2 text-sm text-gray-400">{o.claimDesc.replace('{email}', user.email)}</p>
        <form id="orders-claim" class="mt-4 flex flex-wrap gap-3">
          <input
            type="email"
            name="email"
            value={user.email}
            required
            class="min-w-[260px] flex-1 rounded-lg border border-white/10 bg-black/30 px-3 py-2 text-sm text-white focus:border-blue-500 focus:outline-none"
          />
          <button type="submit" class="rounded-lg bg-white/10 px-4 py-2 text-sm font-semibold text-white ring-1 ring-white/15 hover:bg-white/20">
            {o.claimCta}
          </button>
        </form>
        <p id="orders-claim-status" class="mt-3 text-xs text-gray-400" role="status" aria-live="polite"></p>
      </section>
    )}
  </div>
</Layout>

<script is:inline define:vars={{ copy: { sent: o.guestSent, unavailable: o.guestUnavailable, claimSent: o.claimSent, invalid: t.pay.invalidEmail, failed: t.pay.failed } }}>
  const wire = (formId, statusId, endpoint, okMessage) => {
    const form = document.getElementById(formId);
    if (!form) return;
    const status = document.getElementById(statusId);
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = new FormData(form).get('email');
      const button = form.querySelector('button');
      button.disabled = true;
      status.textContent = '…';
      status.className = 'mt-3 text-xs text-gray-400';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
          status.textContent = okMessage;
          status.className = 'mt-3 text-xs text-emerald-400';
        } else {
          status.textContent =
            data.error === 'email_unavailable'
              ? copy.unavailable
              : data.error === 'invalid_email'
                ? copy.invalid
                : copy.failed;
          status.className = 'mt-3 text-xs text-red-400';
        }
      } catch {
        status.textContent = copy.failed;
        status.className = 'mt-3 text-xs text-red-400';
      }
      button.disabled = false;
    });
  };

  wire('orders-lookup', 'orders-lookup-status', '/api/pay/lookup', copy.sent);
  wire('orders-claim', 'orders-claim-status', '/api/pay/claim', copy.claimSent);
</script>
