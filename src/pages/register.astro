---
import Layout from '../layouts/Layout.astro';
import { RegisterForm } from '../components/auth/RegisterForm';
import { getTranslations } from '../lib/i18n';

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);

// Redirect if already logged in
if (Astro.locals.user) {
  return Astro.redirect('/');
}
---

<Layout title={t.auth.register}>
  <div class="max-w-md mx-auto mt-20 p-6 bg-gray-900/50 border border-gray-800 rounded-xl shadow-2xl">
    <h1 class="text-2xl font-bold text-center mb-8 text-white">{t.auth.register}</h1>
    <RegisterForm client:load locale={locale} translations={{ auth: t.auth }} />
    <div class="mt-6 text-center text-sm text-gray-400">
      {t.nav.hasAccount} <a href="/login" class="text-blue-400 hover:underline no-underline">{t.auth.login}</a>
    </div>
  </div>
</Layout>

