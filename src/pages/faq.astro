---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../lib/i18n';
import { applyPageCache, CACHE_PROFILES } from '../lib/cache/httpCache';

// Pure content with no data dependency: let the edge serve it to anonymous
// visitors and crawlers so these routes never invoke a function per request.
applyPageCache(Astro, CACHE_PROFILES.staticPage);

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);
const f = t.faq;
---

<Layout title={f.title} description={f.metaDescription}>
  <div class="max-w-3xl mx-auto" data-page="faq">
    <h1 class="text-3xl font-bold text-white mb-10">{f.title}</h1>
    <div class="space-y-3">
      {f.items.map((item, i) => (
        <details class="group mkt-card !p-0 overflow-hidden" data-faq-item={i}>
          <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-white font-medium list-none [&::-webkit-details-marker]:hidden">
            {item.q}
            <span class="text-gray-500 group-open:rotate-180 transition-transform ml-4 shrink-0">▼</span>
          </summary>
          <div class="px-6 pb-5 text-gray-400 text-sm leading-relaxed border-t border-gray-800/60 pt-4">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</Layout>

<style>
  details[open] summary {
    color: rgb(96 165 250);
  }
</style>
