---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../lib/i18n';

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);
const lt = t.legal.terms;
---

<Layout title={lt.title} description={lt.metaDescription}>
  <div class="max-w-3xl mx-auto prose prose-invert" data-page="terms">
    <h1 class="text-3xl font-bold text-white mb-2">{lt.title}</h1>
    <p class="text-sm text-gray-500 mb-8">{t.common.lastUpdated}: {t.legal.lastUpdatedDate}</p>

    {lt.sections.map(section => (
      <section class="legal-section">
        <h3>{section.heading}</h3>
        <p>{section.body}</p>
      </section>
    ))}
  </div>
</Layout>
