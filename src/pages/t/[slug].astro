---
import Layout from '../../layouts/Layout.astro';
import { landingService } from '../../lib/services/landing';
import { getLandingDataFromSnapshot } from '../../lib/cache/snapshotReaders';
import { readForPage } from '../../lib/cache/readPath';
import { applyPageCache, CACHE_PROFILES } from '../../lib/cache/httpCache';
import { getTranslations } from '../../lib/i18n';
import { formatNumber, formatGrowthRate, formatDateTime, formatRelativeTime } from '../../lib/utils/format';

export const prerender = false;

applyPageCache(Astro, CACHE_PROFILES.landingDetail);

const locale = Astro.locals.locale || 'zh';
const t = getTranslations(locale);

const slug = Astro.params.slug || '';
const result = await readForPage(
  'landing:detail',
  () => getLandingDataFromSnapshot(slug),
  () => landingService.getLandingData(slug)
);
const data = result.data;

// A missing snapshot for one slug is indistinguishable from an unknown keyword
// from the visitor's point of view, and 404 is the honest answer either way: we
// must not tell a crawler a page exists when we cannot render its content.
if (!data) {
  return new Response(null, { status: 404 });
}

const { keyword, history, bp } = data;
const fill = (s: string) =>
  s.replace('{keyword}', keyword.keyword).replace('{volume}', formatNumber(keyword.searchVolume));

const metaDescription = fill(t.landing.metaDescription);
const siteOrigin = Astro.site?.origin ?? Astro.url.origin;

// FAQPage JSON-LD targets "People also ask"-style rich results for the keyword.
const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: fill(t.landing.faqQ1),
      acceptedAnswer: { '@type': 'Answer', text: fill(t.landing.faqA1) },
    },
    {
      '@type': 'Question',
      name: fill(t.landing.faqQ2),
      acceptedAnswer: { '@type': 'Answer', text: fill(t.landing.faqA2) },
    },
  ],
};
const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.common.appName, item: siteOrigin },
    { '@type': 'ListItem', position: 2, name: t.landing.indexTitle, item: `${siteOrigin}/t` },
    { '@type': 'ListItem', position: 3, name: keyword.keyword, item: `${siteOrigin}/t/${keyword.slug}` },
  ],
};
---

<Layout title={keyword.keyword} description={metaDescription}>
  <article class="space-y-10" data-page="landing-keyword">
    <script type="application/ld+json" set:html={JSON.stringify([faqStructuredData, breadcrumbStructuredData])} />

    <header class="rounded-2xl border border-blue-500/20 bg-gradient-to-br from-blue-600/15 via-gray-900/60 to-purple-600/10 px-6 py-10">
      <p class="text-xs font-medium uppercase tracking-wider text-blue-300">{t.landing.heroEyebrow}</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-white" data-testid="landing-keyword">{keyword.keyword}</h1>
      <dl class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div>
          <dt class="text-xs text-gray-500">{t.landing.searchVolume}</dt>
          <dd class="mt-1 font-mono text-lg text-white">{formatNumber(keyword.searchVolume)}</dd>
        </div>
        <div>
          <dt class="text-xs text-gray-500">{t.landing.growthRate}</dt>
          <dd class="mt-1 font-mono text-lg text-emerald-400">{formatGrowthRate(keyword.growthRate)}</dd>
        </div>
        <div>
          <dt class="text-xs text-gray-500">{t.landing.region}</dt>
          <dd class="mt-1 text-lg text-white">{keyword.region || '—'}</dd>
        </div>
        <div>
          <dt class="text-xs text-gray-500">{t.landing.lastSeen}</dt>
          <dd class="mt-1 text-lg text-white">{formatRelativeTime(keyword.lastSeen, locale)}</dd>
        </div>
      </dl>
    </header>

    <section data-testid="landing-bp-section">
      <h2 class="text-2xl font-bold text-white">{t.landing.bpSectionTitle}</h2>
      {bp ? (
        <div class="mt-4 rounded-xl border border-emerald-500/25 bg-emerald-500/5 p-6">
          <p class="text-sm text-gray-400">{t.landing.bpSectionDesc}</p>
          {bp.title && <p class="mt-3 text-lg font-semibold text-white">{bp.title}</p>}
          {bp.selectedOpportunity && <p class="mt-1 text-sm text-emerald-300">{bp.selectedOpportunity}</p>}
          {bp.summary && <p class="mt-3 line-clamp-4 text-sm leading-relaxed text-gray-300">{bp.summary}</p>}
          <a href={`/bp/${bp.id}`} class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white no-underline shadow-sm transition hover:bg-emerald-500" data-testid="landing-bp-cta">
            {t.landing.bpCta} →
          </a>
        </div>
      ) : (
        <div class="mt-4 rounded-xl border border-gray-800 bg-gray-900/50 p-6">
          <p class="font-semibold text-white">{t.landing.bpPendingTitle}</p>
          <p class="mt-2 text-sm text-gray-400">{t.landing.bpPendingDesc}</p>
          <a href="/bp" class="mt-4 inline-block text-sm text-blue-400 no-underline hover:text-blue-300">{t.home.hero.ctaBp} →</a>
        </div>
      )}
    </section>

    {history.length > 0 && (
      <section>
        <h2 class="text-2xl font-bold text-white">{t.landing.trendHistory}</h2>
        <div class="mt-4 overflow-x-auto rounded-lg border border-gray-800 bg-gray-900/50">
          <table class="w-full text-left text-sm text-gray-400">
            <thead class="bg-gray-800 text-xs font-medium uppercase text-gray-200">
              <tr>
                <th class="px-6 py-3 tracking-wider">{t.landing.historyTime}</th>
                <th class="px-6 py-3 tracking-wider text-right">{t.landing.searchVolume}</th>
                <th class="px-6 py-3 tracking-wider text-right">{t.landing.growthRate}</th>
                <th class="px-6 py-3 tracking-wider">{t.landing.region}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-800">
              {history.map((h) => (
                <tr>
                  <td class="px-6 py-3">{formatDateTime(h.collectedAt, locale)}</td>
                  <td class="px-6 py-3 text-right font-mono text-gray-300">{formatNumber(h.searchVolume)}</td>
                  <td class="px-6 py-3 text-right font-mono text-emerald-400/90">{formatGrowthRate(h.growthRate)}</td>
                  <td class="px-6 py-3">{h.region || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="rounded-2xl border border-gray-800 bg-gray-900/60 px-6 py-10 text-center">
      <h2 class="text-2xl font-bold text-white">{t.landing.ctaTitle}</h2>
      <p class="mx-auto mt-2 max-w-xl text-sm text-gray-400">{t.landing.ctaDesc}</p>
      <div class="mt-6 flex items-center justify-center gap-3">
        <a href="/register" class="rounded-full bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white no-underline shadow-sm transition hover:bg-blue-500">{t.landing.ctaButton}</a>
        <a href="/t" class="rounded-full border border-gray-700 px-6 py-2.5 text-sm font-semibold text-gray-300 no-underline transition hover:border-gray-500">{t.landing.exploreMore}</a>
      </div>
    </section>
  </article>
</Layout>
