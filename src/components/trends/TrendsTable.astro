---
import { formatNumber, formatGrowthRate, formatRelativeTime, formatDateTime } from '../../lib/utils/format';
import { slugifyKeyword } from '../../lib/utils/slug';
import type { Trend } from '../../types';
import { getTranslations } from '../../lib/i18n';

interface Props {
  trends: Trend[];
  locale: 'zh' | 'en';
  noDataLabel?: string;
}

const { trends, locale, noDataLabel } = Astro.props;
const t = getTranslations(locale);
const emptyLabel = noDataLabel ?? t.trends.noData;
---

<div class="overflow-x-auto rounded-lg border border-gray-800 bg-gray-900/50 shadow-xl">
  <table class="w-full text-left text-sm text-gray-400">
    <thead class="bg-gray-800 text-gray-200 uppercase text-xs font-medium">
      <tr>
        <th scope="col" class="px-6 py-4 tracking-wider">{t.trends.keyword}</th>
        <th scope="col" class="px-6 py-4 tracking-wider text-right">{t.trends.searchVolume}</th>
        <th scope="col" class="px-6 py-4 tracking-wider text-right">{t.trends.growthRate}</th>
        <th scope="col" class="px-6 py-4 tracking-wider">{t.trends.category}</th>
        <th scope="col" class="px-6 py-4 tracking-wider text-right">{t.trends.timestamp}</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-800">
      {trends.length > 0 ? (
        trends.map((trend) => (
          <tr class="hover:bg-gray-800/50 transition-colors group">
            <td class="px-6 py-4 font-medium text-white group-hover:text-blue-400 transition-colors">
              {slugifyKeyword(trend.keyword) ? (
                <a href={`/t/${slugifyKeyword(trend.keyword)}`} class="no-underline">{trend.keyword}</a>
              ) : (
                trend.keyword
              )}
            </td>
            <td class="px-6 py-4 text-right font-mono">
              {formatNumber(trend.searchVolume)}
            </td>
            <td class="px-6 py-4 text-right font-mono">
              <span class={trend.growthRate > 0 ? 'text-green-400' : 'text-red-400'}>
                {formatGrowthRate(trend.growthRate)}
              </span>
            </td>
            <td class="px-6 py-4">
              <span class="inline-flex items-center rounded-full bg-gray-800 px-2.5 py-0.5 text-xs font-medium text-gray-300 border border-gray-700">
                {trend.category}
              </span>
            </td>
            <td class="px-6 py-4 text-right text-gray-500" title={formatDateTime(new Date(trend.timestamp), locale)}>
              {formatRelativeTime(new Date(trend.timestamp), locale)}
            </td>
          </tr>
        ))
      ) : (
        <tr>
          <td colspan="5" class="px-6 py-12 text-center text-gray-500">
            {emptyLabel}
          </td>
        </tr>
      )}
    </tbody>
  </table>
</div>

