# Values for the STANDBY (reader) Netlify site.
# Copy to .env.standby (gitignored), fill in, then:
#   NETLIFY_TOKEN_STANDBY=... NETLIFY_SITE_ID_STANDBY=... \
#     node scripts/standby-env.mjs --from=.env.standby
#
# SITE_ROLE is forced to "reader" by the script — do not put writer here.
# Payment keys MUST equal the primary site, or a failover breaks download links
# and webhook signature verification.

DATABASE_URL=
SESSION_SECRET=
CRON_SECRET=
ADMIN_SECRET=

# Optional — only needed if this site is ever promoted to writer
LLM_API_ENDPOINTS=
LLM_API_KEY=

# Payments (same values as primary; leave blank until Creem/LS/Resend are ready)
PAYMENT_TOKEN_SECRET=
CREEM_API_KEY=
CREEM_PRODUCT_ID=
CREEM_WEBHOOK_SECRET=
# CREEM_TEST_MODE=true
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=ioni.top <no-reply@ioni.top>
PAYMENT_PRICE_CENTS=100
